# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rateio_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rateio_dev"

# Supabase runtime on Vercel:
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Supabase for manual migrations:
# DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT (OBRIGATÓRIAS: o boot é recusado se ausentes, com menos de 32 caracteres ou iguais)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Verifique o ambiente antes do deploy com: npm run check:env
JWT_SECRET=""
JWT_REFRESH_SECRET=""  # diferente de JWT_SECRET
# JWT_ISSUER="rateio-api"
# JWT_AUDIENCE="rateio-app"
# REFRESH_TTL_DAYS=30

# Pepper das senhas. ATENÇÃO: NÃO altere nem adicione em produção sem plano de migração:
# os hashes existentes deixam de validar. Ausente = pepper vazio (aviso no boot).
PASSWORD_PEPPER="<pepper-aleatorio>"

# Recuperação de senha (opcional: ausente = derivado de JWT_SECRET via HKDF, com aviso)
# RESET_CODE_SECRET="<valor-aleatorio-com-32+-caracteres>"
# RESET_CODE_TTL_MINUTES=15
# RESET_MAX_ATTEMPTS=5

# Google OAuth
# Comma-separated client IDs accepted as Google ID token audiences.
# For @react-native-google-signin/google-signin, include the Web Client ID used by the app.
GOOGLE_OAUTH_CLIENT_IDS="web-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com,ios-client-id.apps.googleusercontent.com"

# Seed (obrigatórias só para criar o primeiro ADMIN; senha com 12+ caracteres, nunca impressa)
SEED_USER_EMAIL="<email-do-admin>"
SEED_USER_NAME="Admin Rateio"
SEED_USER_PASSWORD="<senha-forte-com-12+-caracteres>"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="<usuario-smtp>"
SMTP_PASS="<senha-de-app-smtp>"
SMTP_FROM="Rateio App <noreply@rateio.app>"

# OCR
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OCR_QUEUE_CONCURRENCY=2
OCR_QUEUE_MAX_ATTEMPTS=3
OCR_QUEUE_MAX_JOBS_PER_RUN=1
OCR_QUEUE_RETRY_DELAY_MS=30000
OCR_QUEUE_LOCK_TIMEOUT_MS=120000
INTERNAL_CRON_SECRET="<segredo-aleatorio-do-cron>"
CRON_SECRET="<segredo-aleatorio-do-cron>"
# OCR_IMAGE_URL_TTL_SECONDS=120
# Retenção (0 = desativada; só ligar após decisão de produto)
# OCR_RAW_TEXT_RETENTION_DAYS=0
# BILL_IMAGE_RETENTION_DAYS=0

# Optional alternative OCR providers
GOOGLE_VISION_API_KEY=""
AWS_TEXTRACT_REGION=""
AWS_TEXTRACT_ACCESS_KEY=""
AWS_TEXTRACT_SECRET_KEY=""

# Storage
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_S3_ACCESS_KEY=""
AWS_S3_SECRET_KEY=""
# Definida = imagens acessíveis por URL pública permanente (aviso no boot)
AWS_S3_PUBLIC_BASE_URL=""
PUBLIC_BASE_URL="http://localhost:3000"
# READ_URL_TTL_SECONDS=3600
# LOCAL_FILES_SECRET="<opcional: só modo local; ausente = derivado de JWT_SECRET>"

# Server
PORT=3000
NODE_ENV=development
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Observabilidade (ausente = /metrics desabilitado com 404)
# METRICS_TOKEN="<token-aleatorio-com-32+-caracteres>"

# CORS (ausente = aberto como hoje, com aviso). Lista separada por vírgula.
# CORS_ALLOWED_ORIGINS="https://app.exemplo.com"

# Flags de compatibilidade (defaults = comportamento atual; aceitam só true/false)
# REQUIRE_CURRENT_PASSWORD=false
# REFRESH_ROTATION_ENABLED=false
# REFRESH_ROTATION_GRACE_SECONDS=60
# HEALTH_STRICT_STATUS=false
# REQUIRE_UPLOAD_SIZE=false
# UPLOAD_SIGNATURE_ENFORCE=false
# REQUIRE_EMAIL_VERIFICATION=false
# RATE_LIMIT_STORE=memory
