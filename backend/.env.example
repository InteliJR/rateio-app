# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rateio_dev"

# Supabase runtime on Vercel:
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Supabase for manual migrations:
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
PASSWORD_PEPPER="your-password-pepper-secret"

# Seed
SEED_USER_EMAIL="admin@rateio.com"
SEED_USER_NAME="Admin Rateio"
SEED_USER_PASSWORD="Admin@123456"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"
SMTP_FROM="Rateio App <noreply@rateio.app>"

# OCR
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OCR_QUEUE_CONCURRENCY=2
OCR_QUEUE_MAX_ATTEMPTS=3
OCR_QUEUE_RETRY_DELAY_MS=30000
OCR_QUEUE_LOCK_TIMEOUT_MS=120000
INTERNAL_CRON_SECRET="troque-este-segredo"

# Optional alternative OCR providers
GOOGLE_VISION_API_KEY=""
AWS_TEXTRACT_REGION=""
AWS_TEXTRACT_ACCESS_KEY=""
AWS_TEXTRACT_SECRET_KEY=""

# Storage
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_S3_ACCESS_KEY=""
AWS_S3_SECRET_KEY=""
AWS_S3_PUBLIC_BASE_URL=""
PUBLIC_BASE_URL="http://localhost:3000"

# Server
PORT=3000
NODE_ENV=development
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
