# .env.example

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rateio_dev"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
PASSWORD_PEPPER="your-password-pepper-secret"

# Seed (Admin inicial)
SEED_USER_EMAIL="admin@rateio.com"
SEED_USER_NAME="Admin Rateio"
SEED_USER_PASSWORD="Admin@123456"

# Email (Recuperação de senha)
# Use suas credenciais SMTP. Exemplos: Gmail, SendGrid, Mailgun, etc.
# Para Gmail: habilite "Senhas de app" em myaccount.google.com/security
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"
SMTP_FROM="Rateio App <noreply@rateio.app>"

# OCR (será configurado depois)
GOOGLE_VISION_API_KEY=""
# OU
AWS_TEXTRACT_REGION=""
AWS_TEXTRACT_ACCESS_KEY=""
AWS_TEXTRACT_SECRET_KEY=""

# Storage (será configurado depois)
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_S3_ACCESS_KEY=""
AWS_S3_SECRET_KEY=""

# Server
PORT=3000
NODE_ENV=development