{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": "security/.*\\.spec\\.ts$",
  "setupFiles": ["<rootDir>/helpers/setup-env.ts"],
  "testEnvironment": "node",
  "testTimeout": 60000,
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.security.json" }]
  }
}
