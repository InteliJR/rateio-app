          "email": "string",
          "id": "string",
          "isActive": "boolean",
          "name": "string",
          "role": "string",
          "updatedAt": "string"
        }
      ]
    },
    "admin.createUser": {
      "status": 201,
      "body": {
        "avatarUrl": null,
