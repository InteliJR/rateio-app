      "content-security-policy": true,
      "cross-origin-resource-policy": "cross-origin",
      "x-powered-by": null
    },
    "cors.noOrigin": {
      "status": 200,
      "allowOrigin": "*"
    },
    "cors.webOriginDefault": {
      "preflightStatus": 204,
      "preflightAllowOrigin": "*",
      "simpleAllowOrigin": "*"
    },
    "throttle.auth": {
      "login": [
        401,
        401,
        401,
        429
