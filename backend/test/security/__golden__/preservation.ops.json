    "cron.noSecret": {
      "status": 403,
      "body": {
        "error": "Forbidden",
        "message": "Invalid internal credential.",
        "statusCode": 403
      }
    },
    "cron.wrongSecret": {
      "status": 403,
      "body": {
        "error": "Forbidden",
        "message": "Invalid internal credential.",
        "statusCode": 403
      }
