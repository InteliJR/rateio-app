// prisma/schema.prisma
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String?
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  avatarUrl String?
  googleId  String?  @unique
  googleAvatarUrl String?
  emailVerifiedAt DateTime?
  creditPolicy CreditPolicy @default(METERED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills              Bill[]
  ocrJobs            OcrJob[]
  purchases          Purchase[]
  revokedTokens      RevokedToken[]
  creditTransactions CreditTransaction[]
  creditReservations CreditReservation[]

  @@map("users")
}

model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@index([userId])
  @@map("revoked_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@map("password_reset_tokens")
}

// ============================================
// CONTAS (BILLS)
// ============================================

enum BillStatus {
  PENDING_OCR // Aguardando processamento OCR
  OCR_FAILED // Falha no OCR
  REVIEWING // Usuário revisando itens
  DIVIDING // Usuário dividindo conta
  COMPLETED // Divisão finalizada
}

enum MeasurementUnit {
  UNIT
  KILOGRAM
  GRAM
  LITER
  MILLILITER
}

model Bill {
  id                String     @id @default(uuid())
  userId            String
  imageUrl          String? // URL da imagem no S3
  imageKey          String? // Chave do S3 para deletar
  status            BillStatus @default(PENDING_OCR)
  ocrRawText        String?    @db.Text // Texto bruto do OCR
  totalAmount       Decimal?   @db.Decimal(10, 2)
  establishmentName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        BillItem[]
  participants Participant[]
  fees         Fee[]
  ocrJob       OcrJob?

  idempotencyKeys IdempotencyKey[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("bills")
}

// ============================================
// ITENS DA CONTA
// ============================================

model BillItem {
  id              String          @id @default(uuid())
  billId          String
  name            String
  quantity        Decimal         @default(1) @db.Decimal(12, 3)
  measurementUnit MeasurementUnit @default(UNIT)
  unitPrice       Decimal         @db.Decimal(10, 2)
  totalPrice      Decimal         @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bill      Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  divisions Division[]

  @@index([billId])
  @@map("bill_items")
}

// ============================================
// PARTICIPANTES
// ============================================

model Participant {
  id     String @id @default(uuid())
  billId String
  name   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bill      Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  divisions Division[]

  @@index([billId])
  @@map("participants")
}

// ============================================
// DIVISÕES (Quem paga o quê)
// ============================================

model Division {
  id            String  @id @default(uuid())
  billItemId    String
  participantId String
  shareAmount   Decimal @db.Decimal(10, 2) // Valor que essa pessoa paga deste item

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billItem    BillItem    @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([billItemId, participantId]) // Cada pessoa divide cada item apenas 1x
  @@index([billItemId])
  @@index([participantId])
  @@map("divisions")
}

// ============================================
// TAXAS (Garçom, Couvert artístico)
// ============================================

enum FeeType {
  SERVICE_PERCENTAGE // Taxa de serviço (% sobre total)
  SERVICE_FIXED // Taxa fixa de serviço
  COVER_CHARGE // Couvert artístico fixo
}

enum OcrJobStatus {
  PENDING
  RUNNING
  FAILED
  COMPLETED
}

model OcrJob {
  id         String       @id @default(uuid())
  billId      String       @unique
  userId      String
  status      OcrJobStatus @default(PENDING)
  attempts    Int          @default(0)
  lockedAt    DateTime?
  availableAt DateTime     @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?      @db.Text
  imageKey    String? // Imagem alvo/processada por este job (null = jobs anteriores à coluna)
  creditRun   Int          @default(1) // Execução de cobrança: +1 a cada recriação do job (chave do crédito = jobId, ou jobId:n para n > 1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([userId])
  @@index([lockedAt])
  @@map("ocr_jobs")
}

/// Chave de idempotência (cabeçalho Idempotency-Key) por usuário e operação de OCR.
/// userId não tem relação com User de propósito: a exclusão em cascata vem pela conta.
model IdempotencyKey {
  id          String   @id @default(uuid())
  userId      String
  key         String // UUID enviado pelo cliente
  operation   String // CREATE_WITH_IMAGE | ATTACH_IMAGE | RETRY_OCR
  requestHash String // sha256 do payload relevante da operação
  billId      String
  ocrJobId    String?
  createdAt   DateTime @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([billId])
  @@index([createdAt])
  @@map("idempotency_keys")
}

enum OcrRunOutcome {
  COMPLETED // Resultado gravado na conta
  RETRY_SCHEDULED // Falhou e o job voltou para a fila (errorCategory = motivo da retentativa)
  FAILED_FINAL // Falha final (esgotamento de tentativas = FAILED_FINAL com errorCategory diferente de IMAGE_MISSING)
  DISCARDED // Execução que perdeu o job ou resultado de imagem/conta que já mudou
}

enum OcrErrorCategory {
  TRANSIENT // 429, 5xx e queda de conexão
  TIMEOUT // timeout do provedor ou lock vencido
  CREDENTIAL // 401 e 403
  INVALID_REQUEST // 400 e demais 4xx
  IMAGE_MISSING // conta sem imagem
  INVALID_RESULT // sem itens, texto curto ou resposta vazia
  EXHAUSTED // reservada ao lock vencido com tentativas esgotadas
  INTERNAL // erro interno (ex.: banco)
  UNKNOWN
}

/// Uma linha por execução do job de OCR (o OcrJob é reaproveitado e zeraria o histórico).
/// NÃO guarda userId, imageUrl, rawText, itens, preços nem mensagens de erro cruas.
/// Sem chave estrangeira de propósito: o histórico de custo sobrevive à exclusão da
/// conta, mas, sem userId, deixa de ser ligável a uma pessoa.
/// Sem índice único em (ocrJobId, attempt): o job é recriado e attempts volta a 0;
/// startedAt identifica a execução.
model OcrRunMetric {
  id                String            @id @default(uuid())
  ocrJobId          String
  billId            String
  attempt           Int // nº da execução na vida atual do job (1-based)
  startedAt         DateTime // momento do claim
  provider          String // 'openai'
  model             String? // null quando o provedor não foi chamado
  outcome           OcrRunOutcome
  errorCategory     OcrErrorCategory?
  httpStatus        Int?
  errorCode         String?           @db.VarChar(64) // só código curto em padrão seguro
  providerRequestId String?           @db.VarChar(64)
  queueWaitMs       Int
  openaiMs          Int?
  totalMs           Int
  openaiCalls       Int? // chamadas da camada própria de retentativa (sem as do SDK)
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  items             Int? // itens gravados (só em COMPLETED)
  estimatedCostUsd  Decimal?          @db.Decimal(12, 6) // ESTIMADO, ver ocr-pricing.ts
  pricingVersion    String?
  createdAt         DateTime          @default(now())

  @@index([createdAt])
  @@index([ocrJobId])
  @@index([model, createdAt])
  @@map("ocr_run_metrics")
}

model Fee {
  id          String  @id @default(uuid())
  billId      String
  type        FeeType
  description String?
  value       Decimal @db.Decimal(10, 2) // Valor ou percentual

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("fees")
}

// ============================================
// COMPRAS (GOOGLE PLAY)
// ============================================

enum PurchaseStatus {
  PENDING // Compra aguardando confirmação de pagamento na loja
  CREDITED // Compra validada e créditos concedidos
  CANCELED // Compra cancelada na loja
  REJECTED // Compra recusada (ex.: pertence a outra conta)
}

model Purchase {
  id            String         @id @default(uuid())
  userId        String
  productId     String
  purchaseToken String         @unique
  orderId       String?
  status        PurchaseStatus @default(PENDING)
  credits       Int
  consumedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("purchases")
}

// ============================================
// CRÉDITOS (LEDGER)
// ============================================

enum CreditPolicy {
  METERED // Consome créditos por leitura (padrão)
  UNLIMITED // Conta isenta, ex.: restaurante parceiro
}

enum CreditTransactionType {
  FREE_GRANT // Cota gratuita concedida
  PURCHASE // Créditos comprados na loja
  AD_REWARD // Crédito concedido por anúncio assistido
  RESERVE // Crédito reservado para uma leitura
  CONSUME // Reserva confirmada: a leitura foi utilizável
  RELEASE // Reserva devolvida: falha nossa ou do provedor
  ADMIN_ADJUST // Ajuste manual do suporte
}

enum CreditReservationStatus {
  HELD
  CONSUMED
  RELEASED
}

/// Ledger imutável. O saldo é a soma de `amount`; nenhuma linha é editada ou apagada.
model CreditTransaction {
  id             String                @id @default(uuid())
  userId         String
  type           CreditTransactionType
  amount         Int // Positivo concede, negativo retira
  idempotencyKey String                @unique
  ocrJobId       String?
  purchaseToken  String?
  reason         String?               @db.Text
  actorId        String? // Quem executou, nos ajustes administrativos
  createdAt      DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ocrJobId])
  @@map("credit_transactions")
}

/// Reservas em aberto. Uma por trabalho de OCR.
model CreditReservation {
  id        String                  @id @default(uuid())
  userId    String
  ocrJobId  String                  @unique
  status    CreditReservationStatus @default(HELD)
  expiresAt DateTime
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, expiresAt])
  @@map("credit_reservations")
}
