// prisma/schema.prisma
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String?
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  avatarUrl String?
  googleId  String?  @unique
  googleAvatarUrl String?
  emailVerifiedAt DateTime?
  creditPolicy CreditPolicy @default(METERED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills              Bill[]
  ocrJobs            OcrJob[]
  revokedTokens      RevokedToken[]
  creditTransactions CreditTransaction[]
  creditReservations CreditReservation[]

  @@map("users")
}

model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@index([userId])
  @@map("revoked_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@map("password_reset_tokens")
}

// ============================================
// CONTAS (BILLS)
// ============================================

enum BillStatus {
  PENDING_OCR // Aguardando processamento OCR
  OCR_FAILED // Falha no OCR
  REVIEWING // Usuário revisando itens
  DIVIDING // Usuário dividindo conta
  COMPLETED // Divisão finalizada
}

enum MeasurementUnit {
  UNIT
  KILOGRAM
  GRAM
  LITER
  MILLILITER
}

model Bill {
  id                String     @id @default(uuid())
  userId            String
  imageUrl          String? // URL da imagem no S3
  imageKey          String? // Chave do S3 para deletar
  status            BillStatus @default(PENDING_OCR)
  ocrRawText        String?    @db.Text // Texto bruto do OCR
  totalAmount       Decimal?   @db.Decimal(10, 2)
  establishmentName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        BillItem[]
  participants Participant[]
  fees         Fee[]
  ocrJob       OcrJob?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("bills")
}

// ============================================
// ITENS DA CONTA
// ============================================

model BillItem {
  id              String          @id @default(uuid())
  billId          String
  name            String
  quantity        Decimal         @default(1) @db.Decimal(12, 3)
  measurementUnit MeasurementUnit @default(UNIT)
  unitPrice       Decimal         @db.Decimal(10, 2)
  totalPrice      Decimal         @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bill      Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  divisions Division[]

  @@index([billId])
  @@map("bill_items")
}

// ============================================
// PARTICIPANTES
// ============================================

model Participant {
  id     String @id @default(uuid())
  billId String
  name   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bill      Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  divisions Division[]

  @@index([billId])
  @@map("participants")
}

// ============================================
// DIVISÕES (Quem paga o quê)
// ============================================

model Division {
  id            String  @id @default(uuid())
  billItemId    String
  participantId String
  shareAmount   Decimal @db.Decimal(10, 2) // Valor que essa pessoa paga deste item

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billItem    BillItem    @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([billItemId, participantId]) // Cada pessoa divide cada item apenas 1x
  @@index([billItemId])
  @@index([participantId])
  @@map("divisions")
}

// ============================================
// TAXAS (Garçom, Couvert artístico)
// ============================================

enum FeeType {
  SERVICE_PERCENTAGE // Taxa de serviço (% sobre total)
  SERVICE_FIXED // Taxa fixa de serviço
  COVER_CHARGE // Couvert artístico fixo
}

enum OcrJobStatus {
  PENDING
  RUNNING
  FAILED
  COMPLETED
}

model OcrJob {
  id         String       @id @default(uuid())
  billId      String       @unique
  userId      String
  status      OcrJobStatus @default(PENDING)
  attempts    Int          @default(0)
  lockedAt    DateTime?
  availableAt DateTime     @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([userId])
  @@index([lockedAt])
  @@map("ocr_jobs")
}

model Fee {
  id          String  @id @default(uuid())
  billId      String
  type        FeeType
  description String?
  value       Decimal @db.Decimal(10, 2) // Valor ou percentual

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("fees")
}

// ============================================
// CRÉDITOS (LEDGER)
// ============================================

enum CreditPolicy {
  METERED // Consome créditos por leitura (padrão)
  UNLIMITED // Conta isenta, ex.: restaurante parceiro
}

enum CreditTransactionType {
  FREE_GRANT // Cota gratuita concedida
  PURCHASE // Créditos comprados na loja
  AD_REWARD // Crédito concedido por anúncio assistido
  RESERVE // Crédito reservado para uma leitura
  CONSUME // Reserva confirmada: a leitura foi utilizável
  RELEASE // Reserva devolvida: falha nossa ou do provedor
  ADMIN_ADJUST // Ajuste manual do suporte
}

enum CreditReservationStatus {
  HELD
  CONSUMED
  RELEASED
}

/// Ledger imutável. O saldo é a soma de `amount`; nenhuma linha é editada ou apagada.
model CreditTransaction {
  id             String                @id @default(uuid())
  userId         String
  type           CreditTransactionType
  amount         Int // Positivo concede, negativo retira
  idempotencyKey String                @unique
  ocrJobId       String?
  purchaseToken  String?
  reason         String?               @db.Text
  actorId        String? // Quem executou, nos ajustes administrativos
  createdAt      DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ocrJobId])
  @@map("credit_transactions")
}

/// Reservas em aberto. Uma por trabalho de OCR.
model CreditReservation {
  id        String                  @id @default(uuid())
  userId    String
  ocrJobId  String                  @unique
  status    CreditReservationStatus @default(HELD)
  expiresAt DateTime
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, expiresAt])
  @@map("credit_reservations")
}
