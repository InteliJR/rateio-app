# mobile/.env

# ⚠️ IMPORTANTE: Use o IP da sua máquina, NÃO localhost!
# Para descobrir seu IP:
#   Windows: ipconfig (procure IPv4)
#   macOS/Linux: ifconfig ou ip addr

# Exemplo (substitua pelo SEU IP):
EXPO_PUBLIC_API_URL=http://192.168.1.17:3000

# Google Sign-In
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID must be a Web OAuth client ID.
# The native Android client remains configured in Google Cloud with package/SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Producao (APK/EAS): use URL HTTPS publica do backend (ex.: Vercel)
# EXPO_PUBLIC_API_URL=https://seu-backend.vercel.app
